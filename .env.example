# GitHub token for the contribution graph on the Home page.
# Fine-grained personal access token, no repository access or scopes needed (public data only).
GITHUB_TOKEN=

# Vercel Web Analytics API, read on the server by the /analytics page.
# Use a narrowly scoped, read-only token. VERCEL_TEAM_ID is only needed for team-owned projects.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
